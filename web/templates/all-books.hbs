{{~ #*inline "page"}}
<section class="page page--wide all-books">
    <header class="all-books__hero">
        <h1>The Holy Bible</h1>
        <p>King James Version</p>
    </header>
    <nav aria-label="All books">
        <ol class="book-grid">
            {{~ #each links.books as |book|}}
            <li class="book-grid__item">
                <a href="{{url}}">{{label}}</a>
            </li>
            {{~ /each}}
        </ol>
    </nav>
</section>
{{~ /inline}}
{{~> base ~}}
