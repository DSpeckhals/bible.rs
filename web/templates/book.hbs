{{~ #*inline "page"}}
<section class="page book">
    <nav class="page-nav" aria-label="Book navigation">
        {{~ #if links.previous}}
        <a class="nav-link nav-link--prev" rel="prev" href="{{links.previous.url}}" aria-label="Previous: {{links.previous.label}}"></a>
        {{~ else}}
        <span class="nav-spacer" aria-hidden="true"></span>
        {{~ /if}}
        <h1>{{book.name}}</h1>
        {{~ #if links.next}}
        <a class="nav-link nav-link--next" rel="next" href="{{links.next.url}}" aria-label="Next: {{links.next.label}}"></a>
        {{~ else}}
        <span class="nav-spacer" aria-hidden="true"></span>
        {{~ /if}}
    </nav>
    <nav aria-label="Chapters">
        <ol class="chapter-grid">
            {{~ #each chapters as |c|}}
            <li class="chapter-grid__item">
                <a href="{{lookup @root.data.links.chapters @index}}" aria-label="Chapter {{c}}">{{c}}</a>
            </li>
            {{~ /each}}
        </ol>
    </nav>
</section>
{{~ /inline}}
{{~> base ~}}
