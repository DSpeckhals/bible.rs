{{~ #*inline "page"}}
<article class="page chapter">
    <nav class="page-nav" aria-label="Chapter navigation">
        {{~ #if links.previous}}
        <a class="nav-link nav-link--prev" rel="prev" href="{{links.previous.url}}" aria-label="Previous: {{links.previous.label}}"></a>
        {{~ else}}
        <span class="nav-spacer" aria-hidden="true"></span>
        {{~ /if}}
        <h1>{{reference_string}}</h1>
        {{~ #if links.next}}
        <a class="nav-link nav-link--next" rel="next" href="{{links.next.url}}" aria-label="Next: {{links.next.label}}"></a>
        {{~ else}}
        <span class="nav-spacer" aria-hidden="true"></span>
        {{~ /if}}
    </nav>

    <ol class="verses">
        {{~ #each verses as |v|}}
        <li id="v{{v.verse}}">
            <a class="verse-num" href="{{@root.data.links.current.url}}#v{{v.verse}}" aria-label="Verse {{v.verse}}">{{~ v.verse ~}}</a>
            <span class="verse-text">{{{v.words}}}</span>
        </li>
        {{~ /each}}
    </ol>

    <nav class="chapter-tools" aria-label="Chapter tools">
        <div class="chapter-tools__side chapter-tools__side--prev">
            {{~ #if links.previous}}
            <a class="chapter-tools__link" rel="prev" href="{{links.previous.url}}" title="{{links.previous.label}}">{{links.previous.label}}</a>
            {{~ /if}}
        </div>
        <div class="chapter-tools__center">
            {{~ #if reference.verses}}
            <a class="chapter-tools__link chapter-tools__link--full" href="{{links.chapter.url}}" title="{{links.chapter.label}}">Full Chapter</a>
            {{~ /if}}
            <a class="chapter-tools__link chapter-tools__link--book" href="{{links.book.url}}" title="{{links.book.label}}">{{links.book.label}}</a>
        </div>
        <div class="chapter-tools__side chapter-tools__side--next">
            {{~ #if links.next}}
            <a class="chapter-tools__link" rel="next" href="{{links.next.url}}" title="{{links.next.label}}">{{links.next.label}}</a>
            {{~ /if}}
        </div>
    </nav>
</article>
{{~ /inline}}
{{~> base ~}}
