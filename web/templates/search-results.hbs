{{~ #*inline "page"}}
<section class="page page--wide search-results">
    <h1 class="search-results__title">{{@root.meta.title}}</h1>
    {{~ #if matches}}
    <ol class="search-results__list">
        {{~ #each matches as |match|}}
        <li class="search-results__item">
            <a href="{{match.link.url}}">
                <strong>{{match.link.label}}</strong>
                <span>{{{match.text}}}</span>
            </a>
        </li>
        {{~ /each}}
    </ol>
    {{~ else}}
    <p class="search-results__empty">No verses matched. Try a different word or reference.</p>
    {{~ /if}}
</section>
{{~ /inline}}
{{~> base ~}}
